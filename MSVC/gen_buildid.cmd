@echo off
rem
rem Generates ..\Src\BuildID.h with the short git hash (fallback: "unknown").
rem Invoked as a pre-build step by Supermodel.vcxproj. Not tracked in git.
rem
setlocal
set ID=unknown
for /f %%i in ('git rev-parse --short HEAD 2^>nul') do set ID=%%i
(
echo // Generated by gen_buildid.cmd - do not edit.
echo #pragma once
echo #define SUPERMODEL_BUILD_ID "%ID%"
) > "%~dp0..\Src\BuildID.h"
exit /b 0
